@model IEnumerable<OnlineStore.Application.Features.Orders.DTOs.OrderDto>
@using OnlineStore.Core.Enums
@{
    ViewData["Title"] = "My Orders";
}

<h1 class="mb-4">My Orders</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-light-gray);"></i>
            <h4 class="mt-3 mb-2" style="color: var(--text-dark-gray);">No orders yet</h4>
            <p class="text-muted mb-4">You haven't placed any orders yet. Start shopping to see your orders here!</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary" style="border-radius: var(--border-radius-large); font-weight: 600;">
                <i class="bi bi-bag me-2"></i>Browse Products
            </a>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var order in Model)
        {
            <div class="col-12 mb-4">
                <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="mb-1" style="color: var(--text-dark-gray);">
                                            Order #@order.Id
                                        </h5>
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-calendar3 me-1"></i>@order.OrderDate.ToString("MMMM dd, yyyy 'at' HH:mm")
                                        </p>
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-box-seam me-1"></i>@order.OrderItems.Count item(s)
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge @(order.Status == OrderStatus.Created ? "bg-warning" : 
                                                             order.Status == OrderStatus.Paid ? "bg-info" : 
                                                             order.Status == OrderStatus.Shipped ? "bg-primary" : 
                                                             order.Status == OrderStatus.Delivered ? "bg-success" : 
                                                             order.Status == OrderStatus.Completed ? "bg-success" : "bg-danger")" 
                                              style="font-size: 0.9rem; padding: 0.5rem 1rem;">
                                            @order.Status
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <p class="mb-1"><strong>Shipping Address:</strong></p>
                                    <p class="text-muted mb-0 small">
                                        @order.ShippingAddress.Street, @order.ShippingAddress.City, @order.ShippingAddress.State @order.ShippingAddress.ZipCode, @order.ShippingAddress.Country
                                    </p>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Delivery:</strong> <span class="text-muted">@order.DeliveryMethod</span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Payment:</strong> <span class="text-muted">@order.PaymentMethod</span></p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <div class="mb-3">
                                    <p class="mb-1 text-muted small">Total Amount</p>
                                    <h4 class="mb-0 fw-bold" style="color: var(--primary-soft-blue);">
                                        $@order.TotalAmount.ToString("F2")
                                    </h4>
                                </div>
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary" style="border-radius: var(--border-radius-large);">
                                    <i class="bi bi-eye me-2"></i>View Details
                                </a>
                                @if (order.Status == OrderStatus.Created)
                                {
                                    <a asp-action="Payment" asp-route-id="@order.Id" class="btn btn-primary ms-2" style="border-radius: var(--border-radius-large);">
                                        <i class="bi bi-credit-card me-2"></i>Pay Now
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

