@model OnlineStore.Application.Features.Orders.DTOs.OrderDto
@using OnlineStore.Core.Enums
@{
    ViewData["Title"] = "Payment";
}

<h1 class="mb-4">Payment</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
            <div class="card-body">
                <h3 class="card-title mb-4" style="color: var(--text-dark-gray);">Payment Information</h3>
                
                <div class="mb-4">
                    <p class="text-muted mb-1"><strong>Order #@Model.Id</strong></p>
                    <p class="text-muted mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                    <p class="text-muted mb-0"><strong>Total Amount:</strong> $@Model.TotalAmount.ToString("F2")</p>
                </div>

                <hr />

                @if (Model.PaymentMethod == PaymentMethod.CreditCard || Model.PaymentMethod == PaymentMethod.DebitCard)
                {
                    <form asp-action="ProcessPayment" method="post" id="paymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="paymentRequest.Amount" value="@Model.TotalAmount" />
                        <input type="hidden" name="paymentRequest.PaymentMethod" value="@Model.PaymentMethod" />
                        
                        <div class="mb-3">
                            <label for="cardNumber" class="form-label fw-bold">Card Number</label>
                            <input type="text" name="paymentRequest.CardNumber" id="cardNumber" class="form-control" 
                                   placeholder="1234 5678 9012 3456" maxlength="19" required 
                                   pattern="[0-9\s]{13,19}" />
                            <small class="form-text text-muted">Enter your 16-digit card number</small>
                        </div>

                        <div class="mb-3">
                            <label for="cardHolderName" class="form-label fw-bold">Cardholder Name</label>
                            <input type="text" name="paymentRequest.CardHolderName" id="cardHolderName" class="form-control" 
                                   placeholder="John Doe" required maxlength="100" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="expiryDate" class="form-label fw-bold">Expiry Date</label>
                                <input type="text" name="paymentRequest.ExpiryDate" id="expiryDate" class="form-control" 
                                       placeholder="MM/YY" maxlength="5" required pattern="(0[1-9]|1[0-2])\/[0-9]{2}" />
                                <small class="form-text text-muted">MM/YY format</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="cvv" class="form-label fw-bold">CVV</label>
                                <input type="text" name="paymentRequest.CVV" id="cvv" class="form-control" 
                                       placeholder="123" maxlength="4" required pattern="[0-9]{3,4}" />
                                <small class="form-text text-muted">3 or 4 digits</small>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5" style="border-radius: var(--border-radius-large); font-weight: 600;">
                                <i class="bi bi-credit-card me-2"></i>Process Payment
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg" style="border-radius: var(--border-radius-large);">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                }
                else if (Model.PaymentMethod == PaymentMethod.PayPal)
                {
                    <form asp-action="ProcessPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="paymentRequest.Amount" value="@Model.TotalAmount" />
                        <input type="hidden" name="paymentRequest.PaymentMethod" value="@Model.PaymentMethod" />
                        <input type="hidden" name="paymentRequest.CardNumber" value="" />
                        <input type="hidden" name="paymentRequest.CardHolderName" value="" />
                        <input type="hidden" name="paymentRequest.ExpiryDate" value="" />
                        <input type="hidden" name="paymentRequest.CVV" value="" />
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            You will be redirected to PayPal to complete your payment.
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5" style="border-radius: var(--border-radius-large); font-weight: 600;">
                                <i class="bi bi-paypal me-2"></i>Pay with PayPal
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg" style="border-radius: var(--border-radius-large);">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                }
                else if (Model.PaymentMethod == PaymentMethod.BankTransfer)
                {
                    <form asp-action="ProcessPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="paymentRequest.Amount" value="@Model.TotalAmount" />
                        <input type="hidden" name="paymentRequest.PaymentMethod" value="@Model.PaymentMethod" />
                        <input type="hidden" name="paymentRequest.CardNumber" value="" />
                        <input type="hidden" name="paymentRequest.CardHolderName" value="" />
                        <input type="hidden" name="paymentRequest.ExpiryDate" value="" />
                        <input type="hidden" name="paymentRequest.CVV" value="" />
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Bank Transfer Instructions:</strong><br />
                            Please transfer $@Model.TotalAmount.ToString("F2") to:<br />
                            Account: 1234567890<br />
                            Bank: Online Store Bank<br />
                            Reference: Order #@Model.Id
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5" style="border-radius: var(--border-radius-large); font-weight: 600;">
                                <i class="bi bi-bank me-2"></i>Confirm Bank Transfer
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg" style="border-radius: var(--border-radius-large);">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px; border-radius: var(--border-radius-large);">
            <div class="card-body">
                <h4 class="card-title mb-4" style="color: var(--text-dark-gray);">Order Summary</h4>
                
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-semibold">$@Model.OrderItems.Sum(i => i.Subtotal).ToString("F2")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PromoCode) && Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Promo Code Discount (@Model.PromoCode):</span>
                            <span>-$@Model.DiscountAmount.ToString("F2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Delivery:</span>
                        <span class="fw-semibold">$@Model.DeliveryCost.ToString("F2")</span>
                    </div>
                </div>
                
                <div class="border-top pt-3 mt-3">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold" style="font-size: 1.1rem; color: var(--text-dark-gray);">Total:</span>
                        <span class="fw-bold" style="font-size: 1.3rem; color: var(--primary-soft-blue);">$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Format card number input
        document.getElementById('cardNumber')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\s/g, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formattedValue;
        });

        // Format expiry date input
        document.getElementById('expiryDate')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.substring(0, 2) + '/' + value.substring(2, 4);
            }
            e.target.value = value;
        });

        // Only allow numbers for CVV
        document.getElementById('cvv')?.addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/\D/g, '');
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

