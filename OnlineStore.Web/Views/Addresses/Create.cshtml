@model OnlineStore.Core.Entities.Address
@{
    ViewData["Title"] = "Add New Address";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "Orders");
}

<h1 class="mb-4">Add New Address</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Street" class="form-label fw-bold">Street Address</label>
                        <input asp-for="Street" class="form-control" placeholder="123 Main St" required />
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label fw-bold">City</label>
                            <input asp-for="City" class="form-control" placeholder="New York" required />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="State" class="form-label fw-bold">State/Province</label>
                            <input asp-for="State" class="form-control" placeholder="NY" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ZipCode" class="form-label fw-bold">Zip/Postal Code</label>
                            <input asp-for="ZipCode" class="form-control" placeholder="10001" />
                            <span asp-validation-for="ZipCode" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="Country" class="form-label fw-bold">Country</label>
                            <input asp-for="Country" class="form-control" placeholder="United States" required />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                            <label asp-for="IsDefault" class="form-check-label">
                                Set as default address
                            </label>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-5" style="border-radius: var(--border-radius-large); font-weight: 600;" id="saveButton">
                            <i class="bi bi-check-circle me-2"></i>Save Address
                        </button>
                        <a href="@returnUrl" class="btn btn-outline-secondary btn-lg" style="border-radius: var(--border-radius-large);">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

