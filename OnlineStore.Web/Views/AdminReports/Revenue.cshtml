@model OnlineStore.Application.Features.Reports.DTOs.RevenueReportDto
@{
    ViewData["Title"] = "Admin - Revenue Report";
}

<h1 class="mb-4">Revenue Report</h1>

<div class="card mb-4 border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
    <div class="card-body">
        <form asp-action="Revenue" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="startDate" class="form-label">Start Date</label>
                <input type="date" name="startDate" id="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-4">
                <label for="endDate" class="form-label">End Date</label>
                <input type="date" name="endDate" id="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary" style="border-radius: var(--border-radius-large);">Update Report</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="bi bi-cart-check" style="font-size: 2.5rem; color: var(--primary-soft-blue);"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Orders</h6>
                        <h3 class="mb-0" style="color: var(--text-dark-gray);">@Model.TotalOrders</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="bi bi-currency-dollar" style="font-size: 2.5rem; color: var(--primary-soft-blue);"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Revenue</h6>
                        <h3 class="mb-0" style="color: var(--text-dark-gray);">$@Model.TotalRevenue.ToString("F2")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="bi bi-graph-up" style="font-size: 2.5rem; color: var(--primary-soft-blue);"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Average Order Value</h6>
                        <h3 class="mb-0" style="color: var(--text-dark-gray);">$@Model.AverageOrderValue.ToString("F2")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.DailyRevenues != null && Model.DailyRevenues.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body">
            <h5 class="card-title mb-4" style="color: var(--text-dark-gray);">Daily Revenue Breakdown</h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Orders</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var daily in Model.DailyRevenues)
                        {
                            <tr>
                                <td>@daily.Date.ToString("MMM dd, yyyy")</td>
                                <td>@daily.OrderCount</td>
                                <td class="text-end"><strong>$@daily.Revenue.ToString("F2")</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td><strong>Total</strong></td>
                            <td><strong>@Model.DailyRevenues.Sum(d => d.OrderCount)</strong></td>
                            <td class="text-end"><strong>$@Model.DailyRevenues.Sum(d => d.Revenue).ToString("F2")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-light-gray);"></i>
            <h4 class="mt-3 mb-2" style="color: var(--text-dark-gray);">No revenue data found</h4>
            <p class="text-muted">No orders found for the selected date range.</p>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--border-radius-large);">
        <i class="bi bi-arrow-left me-2"></i>Back to Reports
    </a>
</div>

