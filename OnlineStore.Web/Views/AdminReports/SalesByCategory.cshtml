@model IEnumerable<OnlineStore.Application.Features.Reports.DTOs.SalesByCategoryDto>
@{
    ViewData["Title"] = "Admin - Sales by Category";
}

<h1 class="mb-4">Sales by Category</h1>

<div class="card mb-4 border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
    <div class="card-body">
        <form asp-action="SalesByCategory" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="startDate" class="form-label">Start Date</label>
                @{
                    var startDate = ViewBag.StartDate as DateTime?;
                }
                <input type="date" name="startDate" id="startDate" class="form-control" value="@(startDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4">
                <label for="endDate" class="form-label">End Date</label>
                @{
                    var endDate = ViewBag.EndDate as DateTime?;
                }
                <input type="date" name="endDate" id="endDate" class="form-control" value="@(endDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2" style="border-radius: var(--border-radius-large);">Filter</button>
                <a asp-action="SalesByCategory" class="btn btn-outline-secondary" style="border-radius: var(--border-radius-large);">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Total Orders</th>
                            <th>Items Sold</th>
                            <th class="text-end">Total Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.CategoryName</strong></td>
                                <td>@item.TotalOrders</td>
                                <td>@item.TotalItemsSold</td>
                                <td class="text-end"><strong>$@item.TotalRevenue.ToString("F2")</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td><strong>Total</strong></td>
                            <td><strong>@Model.Sum(x => x.TotalOrders)</strong></td>
                            <td><strong>@Model.Sum(x => x.TotalItemsSold)</strong></td>
                            <td class="text-end"><strong>$@Model.Sum(x => x.TotalRevenue).ToString("F2")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-light-gray);"></i>
            <h4 class="mt-3 mb-2" style="color: var(--text-dark-gray);">No sales data found</h4>
            <p class="text-muted">Try adjusting your date filters to see more results.</p>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--border-radius-large);">
        <i class="bi bi-arrow-left me-2"></i>Back to Reports
    </a>
</div>

