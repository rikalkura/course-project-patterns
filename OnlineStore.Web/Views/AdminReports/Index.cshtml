@{
    ViewData["Title"] = "Admin - Reports";
}

<h1 class="mb-4">Reports & Analytics</h1>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--border-radius-large); transition: transform 0.2s;">
            <div class="card-body d-flex flex-column">
                <div class="mb-3">
                    <i class="bi bi-graph-up" style="font-size: 2.5rem; color: var(--primary-soft-blue);"></i>
                </div>
                <h5 class="card-title" style="color: var(--text-dark-gray);">Revenue Report</h5>
                <p class="card-text text-muted flex-grow-1">
                    View revenue statistics and financial performance over a specified time period.
                </p>
                <a asp-action="Revenue" class="btn btn-primary mt-auto" style="border-radius: var(--border-radius-large); font-weight: 600;">
                    <i class="bi bi-arrow-right me-2"></i>View Revenue Report
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--border-radius-large); transition: transform 0.2s;">
            <div class="card-body d-flex flex-column">
                <div class="mb-3">
                    <i class="bi bi-bar-chart" style="font-size: 2.5rem; color: var(--primary-soft-blue);"></i>
                </div>
                <h5 class="card-title" style="color: var(--text-dark-gray);">Sales by Category</h5>
                <p class="card-text text-muted flex-grow-1">
                    Analyze sales performance broken down by product categories.
                </p>
                <a asp-action="SalesByCategory" class="btn btn-primary mt-auto" style="border-radius: var(--border-radius-large); font-weight: 600;">
                    <i class="bi bi-arrow-right me-2"></i>View Category Sales
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--border-radius-large); transition: transform 0.2s;">
            <div class="card-body d-flex flex-column">
                <div class="mb-3">
                    <i class="bi bi-star-fill" style="font-size: 2.5rem; color: var(--primary-soft-blue);"></i>
                </div>
                <h5 class="card-title" style="color: var(--text-dark-gray);">Popular Items</h5>
                <p class="card-text text-muted flex-grow-1">
                    Discover the most popular products based on sales volume and customer preferences.
                </p>
                <a asp-action="PopularItems" class="btn btn-primary mt-auto" style="border-radius: var(--border-radius-large); font-weight: 600;">
                    <i class="bi bi-arrow-right me-2"></i>View Popular Items
                </a>
            </div>
        </div>
    </div>
</div>

<div class="mt-5">
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body">
            <h5 class="card-title mb-3" style="color: var(--text-dark-gray);">
                <i class="bi bi-info-circle me-2"></i>About Reports
            </h5>
            <p class="text-muted mb-0">
                Use the reports above to gain insights into your business performance. All reports support date range filtering 
                to help you analyze specific time periods. Select a report above to get started.
            </p>
        </div>
    </div>
</div>

