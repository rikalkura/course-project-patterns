@model IEnumerable<OnlineStore.Application.Features.Reports.DTOs.PopularItemDto>
@{
    ViewData["Title"] = "Admin - Popular Items";
}

<h1 class="mb-4">Popular Items</h1>

<div class="card mb-4 border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
    <div class="card-body">
        <form asp-action="PopularItems" method="get" class="row g-3">
            <div class="col-md-3">
                <label for="topN" class="form-label">Top N Items</label>
                <input type="number" name="topN" id="topN" class="form-control" value="@ViewBag.TopN" min="1" max="100" />
            </div>
            <div class="col-md-3">
                <label for="startDate" class="form-label">Start Date</label>
                @{
                    var startDate = ViewBag.StartDate as DateTime?;
                }
                <input type="date" name="startDate" id="startDate" class="form-control" value="@(startDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label">End Date</label>
                @{
                    var endDate = ViewBag.EndDate as DateTime?;
                }
                <input type="date" name="endDate" id="endDate" class="form-control" value="@(endDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2" style="border-radius: var(--border-radius-large);">Filter</button>
                <a asp-action="PopularItems" class="btn btn-outline-secondary" style="border-radius: var(--border-radius-large);">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Product Name</th>
                            <th>Quantity Sold</th>
                            <th>Orders</th>
                            <th class="text-end">Total Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary" style="font-size: 1rem; padding: 0.5rem 0.75rem;">#@rank</span>
                                </td>
                                <td><strong>@item.ProductName</strong></td>
                                <td>@item.TotalQuantitySold</td>
                                <td>@item.OrderCount</td>
                                <td class="text-end"><strong>$@item.TotalRevenue.ToString("F2")</strong></td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td colspan="2"><strong>Total</strong></td>
                            <td><strong>@Model.Sum(x => x.TotalQuantitySold)</strong></td>
                            <td><strong>@Model.Sum(x => x.OrderCount)</strong></td>
                            <td class="text-end"><strong>$@Model.Sum(x => x.TotalRevenue).ToString("F2")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-light-gray);"></i>
            <h4 class="mt-3 mb-2" style="color: var(--text-dark-gray);">No popular items found</h4>
            <p class="text-muted">Try adjusting your filters to see more results.</p>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--border-radius-large);">
        <i class="bi bi-arrow-left me-2"></i>Back to Reports
    </a>
</div>

