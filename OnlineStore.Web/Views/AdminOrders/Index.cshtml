@model IEnumerable<OnlineStore.Application.Features.Orders.DTOs.OrderDto>
@using OnlineStore.Core.Enums
@{
    ViewData["Title"] = "Admin - Orders";
}

<h1 class="mb-4">Order Management</h1>

<div class="card mb-4 border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label for="status" class="form-label">Status</label>
                <select name="status" id="status" class="form-select">
                    <option value="">All Statuses</option>
                    @{
                        var selectedStatus = ViewBag.Status as OrderStatus?;
                    }
                    <option value="@OrderStatus.Created" selected="@(selectedStatus == OrderStatus.Created)">Created</option>
                    <option value="@OrderStatus.Paid" selected="@(selectedStatus == OrderStatus.Paid)">Paid</option>
                    <option value="@OrderStatus.Shipped" selected="@(selectedStatus == OrderStatus.Shipped)">Shipped</option>
                    <option value="@OrderStatus.Delivered" selected="@(selectedStatus == OrderStatus.Delivered)">Delivered</option>
                    <option value="@OrderStatus.Completed" selected="@(selectedStatus == OrderStatus.Completed)">Completed</option>
                    <option value="@OrderStatus.Cancelled" selected="@(selectedStatus == OrderStatus.Cancelled)">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="startDate" class="form-label">Start Date</label>
                @{
                    var startDate = ViewBag.StartDate as DateTime?;
                }
                <input type="date" name="startDate" id="startDate" class="form-control" value="@(startDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label">End Date</label>
                @{
                    var endDate = ViewBag.EndDate as DateTime?;
                }
                <input type="date" name="endDate" id="endDate" class="form-control" value="@(endDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2" style="border-radius: var(--border-radius-large);">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--border-radius-large);">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Client</th>
                            <th>Order Date</th>
                            <th>Status</th>
                            <th>Items</th>
                            <th>Total Amount</th>
                            <th>Delivery</th>
                            <th>Payment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.ClientName</td>
                                <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(order.Status == OrderStatus.Created ? "bg-warning" : 
                                                         order.Status == OrderStatus.Paid ? "bg-info" : 
                                                         order.Status == OrderStatus.Shipped ? "bg-primary" : 
                                                         order.Status == OrderStatus.Delivered ? "bg-success" : 
                                                         order.Status == OrderStatus.Completed ? "bg-success" : "bg-danger")">
                                        @order.Status
                                    </span>
                                </td>
                                <td>@order.OrderItems.Count item(s)</td>
                                <td><strong>$@order.TotalAmount.ToString("F2")</strong></td>
                                <td>@order.DeliveryMethod</td>
                                <td>@order.PaymentMethod</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info" style="border-radius: var(--border-radius-large);">
                                            <i class="bi bi-eye me-1"></i>Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm" style="border-radius: var(--border-radius-large);">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-light-gray);"></i>
            <h4 class="mt-3 mb-2" style="color: var(--text-dark-gray);">No orders found</h4>
            <p class="text-muted">Try adjusting your filters to see more results.</p>
        </div>
    </div>
}

