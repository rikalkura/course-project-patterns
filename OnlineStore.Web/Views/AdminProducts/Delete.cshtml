@model OnlineStore.Application.Features.Products.DTOs.ProductDto
@{
    ViewData["Title"] = "Delete Product - Admin";
}

<h1 class="mb-4">Delete Product</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this product?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card">
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                @if (Model.PhotoPath.StartsWith("http://") || Model.PhotoPath.StartsWith("https://"))
                {
                    <img src="@Model.PhotoPath" class="img-fluid" alt="@Model.Name" style="border-radius: var(--border-radius-large);" />
                }
                else
                {
                    <img src="~/@Model.PhotoPath" class="img-fluid" alt="@Model.Name" style="border-radius: var(--border-radius-large);" />
                }
            }
            else
            {
                <div class="product-card-image-placeholder" style="height: 400px;">
                    <span>No Image Available</span>
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="mb-3">@Model.Name</h2>
                <p class="text-muted mb-3">Category: @Model.CategoryName</p>
                
                <div class="mb-3">
                    <strong>Price:</strong> $@Model.Price.ToString("F2")
                </div>
                
                <div class="mb-3">
                    <strong>Stock Quantity:</strong> @Model.StockQuantity
                </div>
                
                <div class="mb-3">
                    <strong>Status:</strong>
                    @if (Model.IsInStock)
                    {
                        <span class="badge bg-success">In Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Stock</span>
                    }
                </div>
                
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p>@Model.Description</p>
                    </div>
                }
                
                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

